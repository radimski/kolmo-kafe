# FORM_SECRET=your-random-secret-min-16-chars
# FORM_ALLOWED_ORIGINS=https://www.kolmokafe.cz
#
# Turnstile — production keys from Cloudflare dashboard (Widgets):
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
#
# Local dev uses always-pass test keys in .env.development (committed).
#
# SMTP — required for production form delivery:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=KOLMO kafe <info@kolmokafe.cz>
