{
  "name": "websites",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "scripts": {
    "dev": "concurrently -n otevru,kinles,kolmo -c green,yellow,cyan \"npm:dev:otevru\" \"npm:dev:kinles\" \"npm:dev:kolmokafe\"",
    "dev:otevru": "npm run dev --workspace @sites/otevru",
    "dev:kinles": "npm run dev --workspace @sites/kinles",
    "dev:kolmokafe": "npm run dev --workspace @sites/kolmokafe",
    "build": "npm run build --workspaces --if-present",
    "build:otevru": "npm run build --workspace @sites/otevru",
    "build:kinles": "npm run build --workspace @sites/kinles",
    "build:kolmokafe": "npm run build --workspace @sites/kolmokafe",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
