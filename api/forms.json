{
  "_comment": "Single source of truth for every form on this site. The engine refuses any form id that is not listed here and drops any field that is not described.",

  "forms": {
    "kontakt": {
      "label": "Zpráva z webu",
      "to": ["info@kolmokafe.cz"],
      "cc": [],
      "subject": "Zpráva z webu — {tema}, {jmeno}",
      "replyTo": "kontakt",
      "confirmation": {
        "field": "kontakt",
        "subject": "Potvrzení — obdrželi jsme vaši zprávu | KOLMO kafe",
        "intro": "Děkujeme za zprávu. Potvrzujeme, že jsme ji obdrželi a co nejdříve se vám ozveme.",
        "footer": "KOLMO kafe · Resort Olešná\nTelefon: +420 725 311 139"
      },
      "minSeconds": 3,
      "maxPerHour": 5,
      "maxPerDay": 20,
      "store": true,

      "fields": {
        "jmeno": {
          "type": "text",
          "label": "Jméno",
          "required": true,
          "min": 2,
          "max": 100
        },
        "kontakt": {
          "type": "email",
          "label": "E-mail",
          "required": true,
          "min": 5,
          "max": 200
        },
        "telefon": {
          "type": "tel",
          "label": "Telefon",
          "required": false,
          "min": 9,
          "max": 30
        },
        "tema": {
          "type": "select",
          "label": "Téma",
          "required": true,
          "options": [
            "Obecný dotaz",
            "Rezervace místa",
            "Soukromá akce / oslava",
            "Spolupráce"
          ]
        },
        "zprava": {
          "type": "textarea",
          "label": "Zpráva",
          "required": true,
          "min": 5,
          "max": 4000,
          "maxLinks": 1
        },
        "souhlas": {
          "type": "consent",
          "label": "Souhlas se zpracováním osobních údajů",
          "required": true
        },
        "lang": {
          "type": "hidden",
          "label": "Jazyk",
          "max": 5
        }
      }
    }
  }
}
